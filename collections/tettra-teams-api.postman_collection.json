          "name": "Search pages",
          "request": {
            "name": "Search pages",
            "description": {
              "content": "Search for pages in the Tettra knowledge base. Results are ranked by page title matches, header matches (H1–H3), and page content. Returns up to 5 results. Omitting the query parameter returns the most recent pages.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "teams",
                ":team_id",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Your Tettra API key for authentication."
                },
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "The search term to query the knowledge base. If omitted, the most recent pages are returned."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "team_id",
                  "description": "(Required) The identifier for the Tettra team."
