  "info": {
    "_postman_id": "c0e8d3cb-9b88-484f-8a2d-33a6cd6493b7",
    "name": "Tettra REST Teams API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "A limited experimental REST API for automating common Tettra tasks and building custom integrations. Supports creating pages, searching the knowledge base, suggesting new pages, suggesting page updates, and submitting questions. All endpoints require an API key available on Scaling and Enterprise plans.",
      "type": "text/plain"
    }
  }
